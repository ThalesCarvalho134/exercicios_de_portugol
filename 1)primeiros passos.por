programa {
  funcao inicio() {
    cadeia nome_do_carro = "Fusca"
    ("1.1")
    escreva("---------------\n1.1\n",nome_do_carro,".\n---------------\n1.2\n")

    ("1.2")
    cadeia nome_do_usuario
    escreva("Qual o seu nome? \n")
    leia (nome_do_usuario)
    escreva("Olá, ",nome_do_usuario,".\n---------------\n1.3\n")

    ("1.3")
    cadeia nome_do_Usuario
    inteiro idade_do_usuario
    escreva("Qual o seu nome? \n")
    leia (nome_do_Usuario)
    escreva("Qual sua idade? \n")
    leia (idade_do_usuario)
    escreva ("Olá ",nome_do_Usuario,", sua idade é ",idade_do_usuario,".")
  }
}
